# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env — it is listed in .gitignore.
# ---------------------------------------------------------------------------

# Which backend to talk to: "mock" | "local" | "remote"
#   mock   -> fully offline deterministic engine (no network, no key needed)
#   local  -> LM Studio / Ollama / vLLM on your own machine
#   remote -> any hosted OpenAI-compatible endpoint
MAS_PROVIDER=mock

# --- local endpoint (LM Studio default shown) ------------------------------
MAS_LOCAL_BASE_URL=http://localhost:1234/v1
MAS_LOCAL_API_KEY=lm-studio
# IMPORTANT: this must be a CHAT/INSTRUCT model id, never an embedding model id.
MAS_LOCAL_CHAT_MODEL=qwen2.5-7b-instruct
MAS_LOCAL_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# --- remote endpoint --------------------------------------------------------
MAS_REMOTE_BASE_URL=https://api.openai.com/v1
MAS_REMOTE_API_KEY=sk-REPLACE-ME
MAS_REMOTE_CHAT_MODEL=gpt-4o-mini
MAS_REMOTE_EMBED_MODEL=text-embedding-3-small

# --- resilience budget (assessment caps: timeout <= 30s, retries <= 3) ------
MAS_REQUEST_TIMEOUT=25
MAS_MAX_RETRIES=2
MAS_MAX_REFINEMENT_LOOPS=2
MAS_ESCALATION_THRESHOLD=80
